---
import { Image } from 'astro:assets';
import content from '../data/content.json';
import recambiosImg from '../assets/projects/recambios-las-margaritas.webp';
import aeriatroisImg from '../assets/projects/aeriatrois.webp';
import cybermilImg from '../assets/projects/cybermil.webp';
import barretoImg from '../assets/projects/barreto-construcciones.webp';

const { projects } = content;

const images: Record<string, ImageMetadata> = {
	'recambios-las-margaritas': recambiosImg,
	aeriatrois: aeriatroisImg,
	cybermil: cybermilImg,
	'barreto-construcciones': barretoImg,
};
---

<section id={projects.id} data-reveal class="section-block">
	<div class="mx-auto max-w-6xl">
		<header class="section-header reveal-header max-w-3xl">
			<h2 class="section-title">{projects.title}</h2>
			{
				projects.subtitle && (
					<p class="section-lead">{projects.subtitle}</p>
				)
			}
		</header>

		<ul class="grid gap-6 md:grid-cols-2">
			{
				projects.items.map((project) => {
					const href = project.url || undefined;
					const Tag = href ? 'a' : 'article';

					return (
						<li class="reveal-item">
							<Tag
								{...(href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {})}
								class="group block cursor-pointer overflow-hidden rounded-xl border border-border-subtle bg-bg-elevated transition-shadow duration-300 hover:shadow-[0_2px_8px_rgba(28,25,23,0.06),0_12px_32px_rgba(28,25,23,0.08)] focus-within:shadow-[0_2px_8px_rgba(28,25,23,0.06),0_12px_32px_rgba(28,25,23,0.08)]"
							>
								<div class="relative aspect-[16/10] overflow-hidden bg-text-main">
									<Image
										src={images[project.image]}
										alt={`Captura del sitio web de ${project.client}`}
										class="h-full w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.04] group-focus-within:scale-[1.04]"
										loading="lazy"
									/>
									<div
										class="absolute inset-0 bg-text-main/30 transition-opacity duration-300 group-hover:opacity-0 group-focus-within:opacity-0"
										aria-hidden="true"
									/>
									<span class="absolute top-4 left-4 rounded-full border border-border-subtle bg-bg-elevated/95 px-3 py-1 text-xs font-medium text-text-muted opacity-100 transition-opacity duration-300 md:opacity-0 md:group-hover:opacity-100 md:group-focus-within:opacity-100">
										{project.tags.join(' · ')}
									</span>
								</div>

								<div class="p-5 sm:p-6">
									<p class="text-xs font-semibold tracking-[0.12em] text-text-light uppercase">
										{project.client}
									</p>
									<h3 class="mt-2 text-lg font-bold tracking-[-0.02em] text-text-main sm:text-xl">
										{project.title}
									</h3>
									<p class="mt-2 text-sm font-medium text-brand-primary sm:text-base">
										{project.highlight}
									</p>
									<span
										class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-primary transition-colors duration-200 group-hover:text-brand-hover"
										aria-hidden="true"
									>
										Ver sitio
										<span
											class="flex size-9 items-center justify-center rounded-full border border-brand-primary text-brand-primary transition-colors duration-200 group-hover:bg-brand-primary group-hover:text-white group-focus-within:bg-brand-primary group-focus-within:text-white"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="16"
												height="16"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<path d="M5 12h14"></path>
												<path d="m13 5 7 7-7 7"></path>
											</svg>
										</span>
									</span>
								</div>
							</Tag>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
