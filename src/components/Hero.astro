---
import content from '../data/content.json';

const { hero } = content;
---

<section class="px-4 pb-12 pt-28 sm:px-6 sm:pb-16 sm:pt-32">
	<div class="mx-auto max-w-6xl">
		<div
			class="hero-enter hero-enter-1 inline-flex items-center gap-2 rounded-full bg-brand-soft px-3 py-1.5 text-sm font-medium text-brand-primary"
		>
			<span class="size-2 shrink-0 rounded-full bg-brand-primary" aria-hidden="true"></span>
			{hero.badge}
		</div>

		<h1
			class="hero-enter hero-enter-2 mt-6 max-w-4xl text-[2.5rem] leading-[1.08] font-bold tracking-[-0.03em] text-balance text-text-main sm:mt-8 sm:text-5xl lg:text-[3.5rem]"
		>
			{hero.headline.before}{' '}
			<span class="text-brand-primary">{hero.headline.highlight}</span> {hero.headline.after}
		</h1>

		<p class="hero-enter hero-enter-3 mt-5 max-w-2xl text-base leading-relaxed text-text-muted sm:mt-6 sm:text-lg">
			{hero.subtitle.before}
			<strong class="font-semibold text-text-main">{hero.subtitle.emphasis}</strong>
			{hero.subtitle.after}
		</p>

		<div class="hero-enter hero-enter-4 mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row sm:items-center sm:gap-4">
			<a
				href={hero.ctas.primary.href}
				class="inline-flex items-center justify-center rounded-xl bg-brand-primary px-6 py-3.5 text-sm font-semibold text-white transition-colors duration-200 hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary sm:text-base"
			>
				{hero.ctas.primary.label}
			</a>
			<a
				href={hero.ctas.secondary.href}
				class="inline-flex items-center justify-center rounded-xl bg-bg-surface px-6 py-3.5 text-sm font-semibold text-text-main transition-colors duration-200 hover:bg-border-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary sm:text-base"
			>
				{hero.ctas.secondary.label}
			</a>
		</div>

		<div class="hero-enter hero-enter-5 mt-12 border-t border-border-subtle pt-8 sm:mt-16 sm:pt-10">
			<dl class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4 sm:gap-6">
				{
					hero.stats.map((stat, index) => (
						<div class="hero-enter" style={`animation-delay: ${320 + index * 50}ms`}>
							<dt class="text-2xl font-bold tracking-[-0.02em] text-text-main sm:text-3xl">
								{stat.value}
							</dt>
							<dd class="mt-1 text-sm text-text-muted">{stat.label}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>
</section>
