---
import content from '../data/content.json';

const { site, cta, footer } = content;
---

<section id={cta.id} class="px-4 py-20 sm:px-6 sm:py-28">
	<div class="mx-auto max-w-3xl text-center">
		<h2
			class="text-3xl leading-tight font-bold tracking-[-0.03em] text-balance text-text-main sm:text-4xl lg:text-[2.75rem]"
		>
			{cta.title}
		</h2>
		<p class="mt-5 text-base leading-relaxed text-text-muted sm:mt-6 sm:text-lg">
			{cta.description}
		</p>
		<a
			href={cta.button.href}
			class="mt-8 inline-flex items-center justify-center rounded-xl bg-brand-primary px-8 py-3.5 text-sm font-semibold text-white transition-colors duration-200 hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary sm:mt-10 sm:text-base"
		>
			{cta.button.label}
		</a>
	</div>
</section>

<footer class="border-t border-border-subtle px-4 py-6 sm:px-6">
	<div class="mx-auto max-w-6xl">
		<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<p class="text-sm font-medium text-text-main">{footer.signature}</p>
				<p class="mt-1 text-sm text-text-muted">{footer.description}</p>
			</div>
			<a
				href={site.linkedin.url}
				target="_blank"
				rel="noopener noreferrer"
				class="text-sm font-medium text-text-muted transition-colors duration-200 hover:text-text-main"
			>
				{site.linkedin.label}
			</a>
		</div>
		<p class="mt-4 text-sm text-text-muted">{footer.copyright}</p>
	</div>
</footer>
