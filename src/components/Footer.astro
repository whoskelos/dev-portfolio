---
import content from '../data/content.json';

const { site, cta, footer } = content;
---

<section id={cta.id} data-reveal class="section-block pb-20 pt-16 sm:pb-28 sm:pt-20">
	<div class="mx-auto max-w-2xl text-center">
		<h2 class="reveal-header section-title">{cta.title}</h2>
		<p class="reveal-item section-lead mx-auto mt-5 sm:mt-6">{cta.description}</p>
		<a
			href={cta.button.href}
			class="reveal-item mt-8 inline-flex items-center justify-center rounded-xl bg-brand-primary px-8 py-3.5 text-sm font-semibold text-white transition-colors duration-200 hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary sm:mt-10 sm:text-base"
		>
			{cta.button.label}
		</a>
	</div>
</section>

<footer data-reveal class="border-t border-border-subtle px-4 py-8 sm:px-6 sm:py-10">
	<div class="mx-auto max-w-6xl">
		<div class="reveal-header flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
			<div class="max-w-md">
				<p class="text-sm font-medium text-text-main">{footer.signature}</p>
				<p class="mt-2 text-sm leading-relaxed text-text-muted">{footer.description}</p>
			</div>
			<a
				href={site.linkedin.url}
				target="_blank"
				rel="noopener noreferrer"
				class="shrink-0 text-sm font-medium text-text-muted transition-colors duration-200 hover:text-text-main"
			>
				{site.linkedin.label}
			</a>
		</div>
		<p class="reveal-item mt-6 text-sm text-text-muted sm:mt-8">{footer.copyright}</p>
	</div>
</footer>
