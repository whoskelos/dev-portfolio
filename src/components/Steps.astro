---
import content from '../data/content.json';

const { steps } = content;
---

<section id={steps.id} data-reveal class="section-block bg-bg-surface">
	<div class="mx-auto max-w-6xl">
		<header class="section-header reveal-header max-w-3xl">
			<h2 class="section-title">{steps.title}</h2>
			{
				steps.subtitle && (
					<p class="section-lead">{steps.subtitle}</p>
				)
			}
		</header>

		<ol class="grid gap-5 md:grid-cols-2 md:gap-6">
			{
				steps.items.map((step, index) => (
					<li class="reveal-item">
						<article
							class="flex h-full items-start gap-4 rounded-xl bg-bg-elevated p-6 shadow-[0_1px_2px_rgba(28,25,23,0.06),0_6px_20px_rgba(28,25,23,0.05)] sm:gap-5 sm:p-8"
						>
							<span
								class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-soft text-sm font-semibold text-brand-primary tabular-nums"
								aria-hidden="true"
							>
								{index + 1}
							</span>
							<div class="min-w-0 flex-1">
								<h3 class="text-lg font-bold tracking-[-0.02em] text-text-main sm:text-xl">
									{step.title}
								</h3>
								<p class="card-copy mt-2">{step.description}</p>
							</div>
						</article>
					</li>
				))
			}
		</ol>
	</div>
</section>
