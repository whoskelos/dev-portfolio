---
import content from '../data/content.json';

const { steps } = content;
---

<section id={steps.id} data-reveal class="bg-bg-surface px-4 py-16 sm:px-6 sm:py-24">
	<div class="mx-auto max-w-6xl">
		<h2
			class="reveal-header max-w-3xl text-3xl leading-tight font-bold tracking-[-0.03em] text-balance text-text-main sm:text-4xl"
		>
			{steps.title}
		</h2>

		<ol class="mt-10 grid gap-4 sm:mt-12 md:grid-cols-2 md:gap-5">
			{
				steps.items.map((step, index) => (
					<li class="reveal-item">
						<article
							class="flex h-full items-start gap-4 rounded-xl bg-bg-elevated p-6 shadow-[0_1px_2px_rgba(28,25,23,0.06),0_6px_20px_rgba(28,25,23,0.05)] sm:gap-5 sm:p-8"
						>
							<span
								class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-soft text-sm font-semibold text-brand-primary tabular-nums"
								aria-hidden="true"
							>
								{index + 1}
							</span>
							<div class="min-w-0">
								<h3 class="text-lg font-bold tracking-[-0.02em] text-text-main">
									{step.title}
								</h3>
								<p class="mt-2 text-base leading-relaxed text-text-muted">
									{step.description}
								</p>
							</div>
						</article>
					</li>
				))
			}
		</ol>
	</div>
</section>
