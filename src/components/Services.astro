---
import content from '../data/content.json';

const { services } = content;
---

<section id={services.id} class="bg-bg-surface px-4 py-16 sm:px-6 sm:py-24">
	<div class="mx-auto max-w-6xl">
		<h2
			class="text-3xl leading-tight font-bold tracking-[-0.03em] text-balance text-text-main sm:text-4xl"
		>
			{services.title}
		</h2>

		<ul class="mt-10 grid gap-4 sm:mt-12 lg:grid-cols-3 lg:gap-5">
			{
				services.items.map((service) => (
					<li>
						<article
							class="flex h-full flex-col rounded-xl bg-bg-elevated p-6 shadow-[0_1px_2px_rgba(28,25,23,0.06),0_6px_20px_rgba(28,25,23,0.05)] sm:p-8"
						>
							<span
								class="inline-flex w-fit rounded-full bg-brand-soft px-3 py-1 text-sm font-semibold text-brand-primary tabular-nums"
							>
								{service.label}
							</span>
							<h3 class="mt-5 text-xl font-bold tracking-[-0.02em] text-text-main">
								{service.title}
							</h3>
							<p class="mt-3 text-base leading-relaxed text-text-muted">
								{service.description}
							</p>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>
