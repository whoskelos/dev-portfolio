---
import content from '../data/content.json';

const { services } = content;
---

<section id={services.id} data-reveal class="section-block bg-bg-surface">
	<div class="mx-auto max-w-6xl">
		<header class="section-header reveal-header max-w-3xl">
			<h2 class="section-title">{services.title}</h2>
			<p class="section-lead">{services.subtitle}</p>
		</header>

		<ul class="grid gap-5 lg:grid-cols-3 lg:gap-6">
			{
				services.items.map((service) => (
					<li class="reveal-item">
						<article
							class="flex h-full flex-col rounded-xl bg-bg-elevated p-6 shadow-[0_1px_2px_rgb(var(--shadow-ink)_/_0.06),0_6px_20px_rgb(var(--shadow-ink)_/_0.05)] sm:p-8"
						>
							<h3 class="text-xl font-bold tracking-[-0.02em] text-text-main sm:text-[1.375rem]">
								{service.title}
							</h3>
							<p class="card-copy mt-3">{service.description}</p>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>
