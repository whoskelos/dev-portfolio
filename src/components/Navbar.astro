---
import content from '../data/content.json';

const { site, navbar } = content;
---

<header data-navbar class="navbar fixed inset-x-0 top-0 z-50">
	<nav class="navbar__inner mx-auto flex items-center justify-between border" aria-label="Principal">
		<a href="/" class="flex min-w-0 items-center gap-2.5 sm:gap-3">
			<span
				class="flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-primary text-sm font-semibold text-white sm:size-9"
				aria-hidden="true"
			>
				{site.brand.initial}
			</span>
			<span class="truncate text-sm font-semibold text-text-main sm:text-base">
				{site.brand.name}
			</span>
		</a>

		<ul class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-8 md:flex">
			{
				navbar.links.map((link) => (
					<li>
						<a
							href={link.href}
							class="text-sm font-medium text-text-muted transition-colors duration-200 hover:text-text-main"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="flex shrink-0 items-center gap-2">
			<a
				href={navbar.cta.href}
				class="hidden rounded-full bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white transition-colors duration-200 hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary md:inline-flex"
			>
				{navbar.cta.label}
			</a>

			<button
				type="button"
				class="navbar__toggle inline-flex size-11 items-center justify-center rounded-full border border-border-subtle bg-bg-elevated text-text-main transition-colors duration-200 hover:bg-bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary md:hidden"
				aria-expanded="false"
				aria-controls="mobile-nav"
				data-nav-toggle
			>
				<span class="sr-only" data-nav-toggle-label>Abrir menú</span>
				<svg
					class="navbar__icon-menu size-5"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M4 6h16"></path>
					<path d="M4 12h16"></path>
					<path d="M4 18h16"></path>
				</svg>
				<svg
					class="navbar__icon-close absolute size-5"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M18 6 6 18"></path>
					<path d="m6 6 12 12"></path>
				</svg>
			</button>
		</div>
	</nav>

	<div
		id="mobile-nav"
		class="navbar__drawer md:hidden"
		hidden
		aria-hidden="true"
		data-nav-panel
	>
		<button type="button" class="navbar__drawer-backdrop" tabindex="-1" data-nav-close aria-hidden="true">
		</button>
		<div class="navbar__drawer-panel">
			<ul class="flex flex-col gap-1">
				{
					navbar.links.map((link) => (
						<li>
							<a
								href={link.href}
								class="navbar__drawer-link"
								data-nav-link
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<a
				href={navbar.cta.href}
				class="navbar__drawer-cta"
				data-nav-link
			>
				{navbar.cta.label}
			</a>
		</div>
	</div>
</header>

<script src="../scripts/navbar.ts"></script>
