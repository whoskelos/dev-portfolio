---
import content from '../data/content.json';

const { site, navbar } = content;
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-6 sm:pt-6">
	<nav
		class="relative mx-auto flex max-w-3xl items-center justify-between rounded-full border border-border-subtle bg-bg-elevated px-3 py-2 sm:max-w-4xl sm:px-5 sm:py-2.5"
		aria-label="Principal"
	>
		<a href="/" class="flex min-w-0 items-center gap-2.5 sm:gap-3">
			<span
				class="flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-primary text-sm font-semibold text-white sm:size-9"
				aria-hidden="true"
			>
				{site.brand.initial}
			</span>
			<span class="truncate text-sm font-semibold text-text-main sm:text-base">
				{site.brand.name}
			</span>
		</a>

		<ul class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-8 md:flex">
			{
				navbar.links.map((link) => (
					<li>
						<a
							href={link.href}
							class="text-sm font-medium text-text-muted transition-colors duration-200 hover:text-text-main"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<a
			href={navbar.cta.href}
			class="shrink-0 rounded-full bg-brand-primary px-4 py-2 text-sm font-semibold text-white transition-colors duration-200 hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary sm:px-5 sm:py-2.5"
		>
			{navbar.cta.label}
		</a>
	</nav>
</header>
